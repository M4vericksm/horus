# ============================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE — NetworkAtlas
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git!
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend (URL de conexão com o banco) ---
# Formato: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

# Ambiente da API: development | production
# Em production, ALLOWED_ORIGINS e ATLAS_API_KEY são obrigatórios.
APP_ENV=development

# Chave Fernet para criptografar tokens/senhas no Postgres.
# Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Chave operacional exigida no header X-API-Key.
# Gerar com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_API_KEY=

# --- CORS: origens permitidas (separadas por vírgula) ---
# Em produção, informe explicitamente o IP/domínio real do frontend.
# Exemplo: http://192.168.0.10,https://meusite.com
ALLOWED_ORIGINS=

# --- SSH: máximo de conexões SSH simultâneas ---
MAX_SSH_CONCURRENT=

# --- Porta exposta pela API backend ---
API_PORT=8000

# --- Senhas iniciais dos usuários de seed ---
# Definidas só na primeira subida (usuário ainda não existe no banco).
# Deixe em branco para gerar uma senha aleatória registrada no log do backend.
ATLAS_SEED_MAVERICK_PASSWORD=
ATLAS_SEED_OPERADOR_PASSWORD=
ATLAS_SEED_DEMO_PASSWORD=
